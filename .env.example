# API
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/ai_erp
UPLOAD_DIR=apps/api/uploads

# AI Provider
AI_PROVIDER_ORDER=gemini,groq,openrouter

# Gemini (primary for PDF + multimodal extraction)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Groq (OpenAI-compatible text fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter (OpenAI-compatible text fallback)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Backward compatibility (optional)
AI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=30000

# Multi-tenant fallback
DEFAULT_TENANT_ID=default-campus
