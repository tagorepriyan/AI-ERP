{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-erp.local/schemas/document-extraction.schema.json",
  "title": "Document Extraction",
  "type": "object",
  "required": ["provider", "model", "confidenceScore", "events", "structured"],
  "properties": {
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "confidenceScore": { "type": "number", "minimum": 0, "maximum": 1 },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["eventId", "confidence"],
        "properties": {
          "eventId": { "type": "string" },
          "date": { "type": "string" },
          "startTime": { "type": "string" },
          "endTime": { "type": "string" },
          "subjectCode": { "type": "string" },
          "subjectName": { "type": "string" },
          "instructions": { "type": "string" },
          "departments": {
            "type": "array",
            "items": { "type": "string" }
          },
          "years": {
            "type": "array",
            "items": { "type": "string" }
          },
          "sections": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    },
    "structured": {
      "type": "object",
      "required": ["documentType", "title", "date", "summary", "targetAudience", "sections"],
      "properties": {
        "documentType": { "type": "string" },
        "title": { "type": "string" },
        "date": { "type": "string" },
        "summary": { "type": "string" },
        "semester": { "type": "string" },
        "examSession": {
          "type": "object",
          "properties": {
            "startTime": { "type": "string" },
            "endTime": { "type": "string" }
          },
          "additionalProperties": false
        },
        "schedule": {
          "type": "array",
          "items": { "type": "object" }
        },
        "intent": {
          "type": "object",
          "properties": {
            "purpose": { "type": "string" },
            "mode": { "type": "string" }
          },
          "additionalProperties": true
        },
        "targetAudience": {
          "type": "array",
          "items": { "type": "string" }
        },
        "sections": {
          "type": "object",
          "properties": {
            "schedule": { "type": "array", "items": {} },
            "rules": { "type": "array", "items": {} },
            "instructions": { "type": "array", "items": {} },
            "restrictions": { "type": "array", "items": {} },
            "announcements": { "type": "array", "items": {} }
          },
          "required": ["schedule", "rules", "instructions", "restrictions", "announcements"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
